# Committed development defaults — Vite loads this automatically in dev mode
# (npm run dev, or docker compose up). NON-SECRET values only.
#
# The local Supabase API key is generated per machine by the CLI and therefore
# is NOT committed. After `supabase start`, run:
#
#   npm run setup:local
#
# which reads the key from `supabase status` and writes it to
# .env.development.local (gitignored, loaded by Vite with higher precedence).

# Local Supabase stack (supabase start) — API gateway default port.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Contact form: blank in dev → the form falls back to the mailto: handoff.
# Point it at a Formspree test form if you're working on the submit flow.
VITE_CONTACT_ENDPOINT=

# Analytics and Sentry stay OFF in development.
VITE_ANALYTICS_DOMAIN=
VITE_SENTRY_DSN=
