# Copy this file to ".env" and fill in values.
#
# ⚠ Everything prefixed VITE_ is baked into the PUBLIC JavaScript bundle at
# build time. Never put a real secret (service-role keys, API keys with
# billing) in a VITE_ variable.

# Supabase backend — the case-studies database. Both values come from your
# Supabase project: Dashboard → Settings → API. The anon key is designed to
# be public; Row-Level Security on the database is the security boundary.
# REQUIRED for case studies to load and for the Content Studio to save.
# Apply supabase/migrations/0001_case_studies.sql to the project first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contact form destination. Create a free form at https://formspree.io and
# paste the endpoint here. Any endpoint that accepts a JSON POST works.
VITE_CONTACT_ENDPOINT=

# Privacy-friendly analytics (Plausible). Set to your verified domain, e.g.
# encytics.ai — leave blank to disable analytics entirely.
VITE_ANALYTICS_DOMAIN=
